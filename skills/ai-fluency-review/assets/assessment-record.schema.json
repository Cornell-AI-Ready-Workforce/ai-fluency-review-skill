{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-ready-workforce.example/schemas/ai-fluency-review/0.2.0",
  "title": "AI Fluency Review assessment record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "rubric_version",
    "renderer_version",
    "meta",
    "evidence_inventory",
    "reliability",
    "standouts",
    "areas",
    "adaptive_flexibility_change"
  ],
  "properties": {
    "schema_version": { "const": "0.2.0" },
    "rubric_version": { "const": "0.2.0" },
    "renderer_version": { "const": "0.2.0" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "generated_on", "review_period", "coverage_line"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "generated_on": { "type": "string", "format": "date" },
        "review_period": { "type": "string", "minLength": 1 },
        "coverage_line": { "type": "string", "minLength": 1 }
      }
    },
    "evidence_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "source_types", "periods", "inventoried_count", "reviewed_count", "sampling_method", "access_limits", "attribution_limits"],
      "properties": {
        "unit": { "type": "string", "minLength": 1 },
        "source_types": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "periods": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "inventoried_count": { "type": "integer", "minimum": 0 },
        "reviewed_count": { "type": "integer", "minimum": 0 },
        "sampling_method": { "type": "string", "minLength": 1 },
        "access_limits": { "$ref": "#/$defs/string_list" },
        "attribution_limits": { "$ref": "#/$defs/string_list" }
      }
    },
    "reliability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_strength", "limitations"],
      "properties": {
        "evidence_strength": { "$ref": "#/$defs/evidence_strength" },
        "limitations": { "$ref": "#/$defs/string_list" }
      }
    },
    "standouts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strongest_observed_habit", "current_focus", "try_next"],
      "properties": {
        "strongest_observed_habit": { "type": "string", "minLength": 1 },
        "current_focus": { "type": "string", "minLength": 1 },
        "try_next": { "type": "string", "minLength": 1 }
      }
    },
    "areas": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/area" },
      "allOf": [
        { "contains": { "properties": { "id": { "const": "description" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "delegation" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "discernment" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "diligence" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 },
        { "contains": { "properties": { "id": { "const": "adaptive-flexibility" } }, "required": ["id"] }, "minContains": 1, "maxContains": 1 }
      ]
    },
    "adaptive_flexibility_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "baseline_period", "baseline_level", "friction", "changed_approach", "verified_result", "later_reuse", "evidence"],
      "properties": {
        "status": { "enum": ["supported", "not-enough-evidence"] },
        "summary": { "type": "string", "minLength": 1 },
        "baseline_period": { "type": ["string", "null"] },
        "baseline_level": { "$ref": "#/$defs/level" },
        "friction": { "type": ["string", "null"] },
        "changed_approach": { "type": ["string", "null"] },
        "verified_result": { "type": ["string", "null"] },
        "later_reuse": { "type": ["string", "null"] },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "maxItems": 2 }
      },
      "if": { "properties": { "status": { "const": "supported" } } },
      "then": {
        "properties": {
          "friction": { "type": "string", "minLength": 1 },
          "changed_approach": { "type": "string", "minLength": 1 },
          "verified_result": { "type": "string", "minLength": 1 },
          "later_reuse": { "type": "string", "minLength": 1 }
        }
      }
    },
    "interaction_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/interaction_event" }
    }
  },
  "$defs": {
    "string_list": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "evidence_strength": { "enum": ["low", "medium", "high"] },
    "level": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "task_label", "summary", "source_label", "source_url", "private_source_id"],
      "properties": {
        "date": { "type": "string", "minLength": 1 },
        "task_label": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "source_label": { "type": ["string", "null"] },
        "source_url": { "type": ["string", "null"] },
        "private_source_id": { "type": ["string", "null"] }
      }
    },
    "area": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_label", "research_label", "level", "evidence_strength", "observed_pattern", "inconsistent_patterns", "evidence_gaps", "opportunities_to_observe", "contexts_observed", "rating_rationale", "recommended_action", "evidence"],
      "properties": {
        "id": { "enum": ["description", "delegation", "discernment", "diligence", "adaptive-flexibility"] },
        "display_label": { "type": "string", "minLength": 1 },
        "research_label": { "type": "string", "minLength": 1 },
        "level": { "$ref": "#/$defs/level" },
        "evidence_strength": { "$ref": "#/$defs/evidence_strength" },
        "observed_pattern": { "type": "string", "minLength": 1 },
        "inconsistent_patterns": { "$ref": "#/$defs/string_list" },
        "evidence_gaps": { "$ref": "#/$defs/string_list" },
        "opportunities_to_observe": { "type": "integer", "minimum": 0 },
        "contexts_observed": { "type": "integer", "minimum": 0 },
        "rating_rationale": { "type": "string", "minLength": 1 },
        "recommended_action": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" }, "maxItems": 2 }
      }
    },
    "interaction_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "action", "actor", "attribution_basis", "provenance_strength", "summary"],
      "properties": {
        "timestamp": { "type": "string", "minLength": 1 },
        "action": { "enum": ["request", "delegate", "inspect", "verify", "revise", "decide", "reuse_practice", "other"] },
        "actor": { "enum": ["human", "agent", "mixed", "unknown"] },
        "attribution_basis": { "enum": ["explicit_authorship", "tracked_change", "event_origin", "session_attribution", "inferred", "unknown"] },
        "provenance_strength": { "$ref": "#/$defs/evidence_strength" },
        "summary": { "type": "string", "minLength": 1 },
        "private_source_id": { "type": ["string", "null"] }
      }
    }
  }
}
